# Clerk: obtain these from the Clerk dashboard. Do not commit real values.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Keep these path values identical in local and Vercel environments so Clerk
# can return a journalist to Discover after a successful sign-in or sign-up.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Supabase Postgres: use the server-only connection string from Supabase.
DATABASE_URL=
# Set to true for Supabase-hosted PostgreSQL. The certificate is verified.
DATABASE_SSL=true
# Optional when the database certificate chain is not already trusted by Node.
# Paste the Supabase database CA certificate as PEM, using \n for line breaks.
# This is a public CA certificate, not a database password or private key.
DATABASE_SSL_CA_CERT=

# OpenAI: server-only. Create a project key with a conservative project budget.
OPENAI_API_KEY=

# Deep Research uses Tavily's HTTPS search API to retrieve source metadata
# before the server asks OpenAI to synthesise a cited report. Keep it server-only.
TAVILY_API_KEY=
# Optional bounded Deep Research tuning. Values above these caps are ignored:
# 4 Tavily Basic searches and 5 results per search.
JOURNOL_DEEP_RESEARCH_MAX_QUERIES=4
JOURNOL_DEEP_RESEARCH_MAX_RESULTS_PER_QUERY=5

# Public records (investigation desk). CAC lookups use Dojah's CAC service;
# leave blank to show journalists CAC's own public search instead. Official-
# site searches for treasury, audit and court records reuse TAVILY_API_KEY.
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
# Optional: https://sandbox.dojah.io while testing.
DOJAH_BASE_URL=

# Shared rate limiting: required in production. For Upstash HTTPS REST, copy
# its REST URL and Standard (not Read Only) token; keep both server-only.
JOURNOL_REQUIRE_SHARED_RATE_LIMIT=true
JOURNOL_RATE_LIMIT_REDIS_URL=
JOURNOL_RATE_LIMIT_REDIS_TOKEN=

# Set only when the deployment proxy overwrites forwarding headers. Vercel
# supplies trusted request forwarding headers for deployed functions.
JOURNOL_TRUST_PROXY=true

# Optional, local-development-only identity seam. Never set in production.
JOURNOL_DEV_USER_ID=

# Legacy stateless AI routes are disabled in production. Do not configure an
# access token for beta users; Journol uses Clerk sessions and ownership checks.
JOURNOL_REQUIRE_AUTH=
JOURNOL_ACCESS_TOKEN=
