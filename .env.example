# Copy to .env.local for local development. Never commit real values.

# Clerk sign-in (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Postgres (Supabase or any PostgreSQL 14+). Server-only.
DATABASE_URL=
# Set to true for Supabase. Optional CA certificate as PEM with \n line breaks.
DATABASE_SSL=true
DATABASE_SSL_CA_CERT=

# OpenAI: reads stories and writes gaps and angles. Server-only.
OPENAI_API_KEY=
# Optional. Defaults to gpt-4.1-mini.
OPENAI_MODEL=

# Tavily: searches the web for related coverage. Server-only.
# Without it Journol still works, but can't say whether an angle has been reported.
TAVILY_API_KEY=

# Optional. AI runs per journalist per 24 hours (a new story or a new set of angles). Default 25.
JOURNOL_DAILY_LIMIT=
# Optional. AI runs across all journalists per 24 hours: the overall spending cap. Default 200.
JOURNOL_GLOBAL_DAILY_LIMIT=

# Guest mode: use Journol without an account. On by default; set to "off" to require sign-in.
JOURNOL_GUEST_MODE=
# New stories per guest per 24 hours (default 3), per internet connection (default 10),
# and the share of the overall cap guests may use together (default 0.5).
JOURNOL_GUEST_DAILY_LIMIT=
JOURNOL_GUEST_CONNECTION_LIMIT=
JOURNOL_GUEST_SHARE=
# Optional: signs guest cookies. If unset, a key is derived from CLERK_SECRET_KEY.
JOURNOL_GUEST_SECRET=
# Cloudflare Turnstile (free): checks a new guest is a person before their first story.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Who can open /admin: comma-separated Clerk user IDs (each user's ID is shown on /account).
JOURNOL_ADMIN_USER_IDS=

# Shown on the Terms and Privacy pages and in the footer.
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
# The public address, used for link previews and install instructions. Default https://journol.onrender.com
NEXT_PUBLIC_SITE_URL=
# Old addresses to send to NEXT_PUBLIC_SITE_URL, comma-separated, e.g. journol.onrender.com
JOURNOL_REDIRECT_HOSTS=

# Local development only: act as this user when Clerk keys are not set. Ignored in production.
JOURNOL_DEV_USER_ID=
